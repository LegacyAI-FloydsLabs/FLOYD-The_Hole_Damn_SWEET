{
  "name": "harness-launcher",
  "version": "1.0.0",
  "description": "Interactive CLI harness launcher with terminal emulation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
