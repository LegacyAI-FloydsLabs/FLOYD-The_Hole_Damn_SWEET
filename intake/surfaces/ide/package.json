{
  "name": "cursem-ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CURSEM — standalone local-first IDE with credential-proxied multi-provider AI routing",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build && node server/cursem-server.mjs",
    "dev:ui": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "start": "node server/cursem-server.mjs",
    "start:server": "node server/cursem-server.mjs",
    "prepare:runtime": "npm run build",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "package:macos": "npm run build && node scripts/package-macos.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:terminalone": "PUPPETEER_EXECUTABLE_PATH=\"${PUPPETEER_EXECUTABLE_PATH:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}\" npm --prefix vendor/TerminalOne test",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "bash-language-server": "^5.6.0",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.3.0",
    "pyright": "^1.1.407",
    "typescript": "~7.0.2",
    "typescript-language-server": "^5.3.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vscode-langservers-extracted": "^4.10.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "dompurify": "^3.4.12",
    "minimatch": "^10.2.4"
  },
  "allowScripts": {
    "core-js": true,
    "fsevents": true,
    "node-pty": true
  }
}
