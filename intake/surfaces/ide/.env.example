# Optional stable loopback ports. Omit to allocate ephemeral ports.
CURSEM_PORT=5188
CURSEM_TERMINAL_PORT=5189

# Optional initial workspace. The --workspace CLI flag takes precedence.
CURSEM_WORKSPACE_ROOT=/absolute/path/to/project

# Optional server-owned provider credentials. Never use VITE_ prefixes.
CURSEM_OPENCODE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CURSEM synchronizes supported API-key credentials from the configured OMP
# auth broker into the ignored .env.local at startup. Explicit process values
# override .env.local. Set sync to 0 only when broker access is intentionally disabled.
CURSEM_AUTH_BROKER_SYNC=1
CURSEM_AUTH_BROKER_URL=
CURSEM_AUTH_BROKER_TOKEN_FILE=
CURSEM_ENV_FILE=

# Optional comma-separated HTTPS provider host allowlist.
CURSEM_GATEWAY_ALLOWED_HOSTS=opencode.ai,api.openai.com,api.anthropic.com
